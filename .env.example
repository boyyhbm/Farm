# Copying this file is insufficient: run ./scripts/bootstrap.sh to generate random secrets.
POSTGRES_PASSWORD=replace_with_random_64_hex_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_unique_long_password
DATABASE_URL=postgresql+psycopg://farm:password@localhost:5432/farm
REDIS_URL=redis://localhost:6379/0
PUBLIC_ORIGIN=https://localhost
SITE_ADDRESS=localhost
TLS_EMAIL=admin@localhost
SESSION_SECURE=true
ENVIRONMENT=production
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=warning
RETENTION_DAYS=30
SESSION_HOURS=12
NODE_OFFLINE_SECONDS=45

# Bounded background inventory rotation; a separate inventory worker handles requests.
INVENTORY_SYNC_INTERVAL_SECONDS=21600

# Linux server integration secret. Windows Desktop configures this via Protection + DPAPI.
STEAM_API_KEY=
